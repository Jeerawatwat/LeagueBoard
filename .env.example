# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า ห้าม commit ไฟล์ .env

# แหล่งข้อมูลของเว็บ
#   mock  = ใช้ JSON ใน mock-data/ ไม่ต้องมี SQL Server
#   mssql = ต่อ SQL Server ตามค่าด้านล่าง
DATA_SOURCE=mock

# พอร์ตของเว็บ เปิดที่ http://localhost:3000
PORT=3000

# กุญแจเซ็น session ใส่ข้อความสุ่มยาวๆ สร้างได้ด้วยคำสั่ง
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ถ้าเว้นว่าง เว็บจะสุ่มใหม่ทุกครั้งที่เริ่ม และทุกคนจะหลุดจากระบบ
SESSION_SECRET=

# ----- ค่าด้านล่างใช้เมื่อ DATA_SOURCE=mssql และกับ npm run db:check -----

# ชื่อเครื่อง SQL Server ใช้ localhost ถ้าอยู่เครื่องเดียวกับเว็บ
DB_SERVER=localhost
# พอร์ต TCP ของ SQL Server ค่ามาตรฐานคือ 1433
DB_PORT=1433
# ชื่อฐานข้อมูล
DB_NAME=LeagueBoard
# เข้ารหัสการเชื่อมต่อ true หรือ false
DB_ENCRYPT=true
# ยอมรับ certificate ที่ไม่ได้ลงนาม ใช้ true กับ SQL Server บนเครื่องตัวเอง
DB_TRUST_SERVER_CERTIFICATE=true

# SQL login ของแต่ละ role ต้องตรงกับ database/07_security.sql
# ผู้เข้าชมที่ยังไม่ login
DB_VIEWER_USER=lb_viewer
DB_VIEWER_PASSWORD=
# ผู้ใช้ role team_manager
DB_TEAM_MANAGER_USER=lb_team_manager
DB_TEAM_MANAGER_PASSWORD=
# ผู้ใช้ role referee
DB_REFEREE_USER=lb_referee
DB_REFEREE_PASSWORD=
# ผู้ใช้ role admin
DB_ADMIN_USER=lb_admin
DB_ADMIN_PASSWORD=
# ใช้กับ npm run db:check และหน้า /db-check
DB_CHECKER_USER=lb_checker
DB_CHECKER_PASSWORD=
